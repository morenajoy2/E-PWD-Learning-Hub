RewriteEngine On
RewriteBase /EPWD/

RewriteRule ^$ Login [L,R=302]


RewriteRule ^admin/content/management/?$ admin/content/management.php [L,QSA]
RewriteRule ^admin/content/add/?$ admin/content/add.php [L,QSA]
RewriteRule ^admin/content/view/([0-9]+)/?$ admin/content/view.php?content_id=$1 [L,QSA]
RewriteRule ^admin/content/edit/([0-9]+)/?$ admin/content/edit.php?id=$1 [L,QSA]
RewriteRule ^admin/content/delete/([0-9]+)/?$ admin/content/delete.php?content_id=$1 [L,QSA]

RewriteRule ^admin/announcement/management/?$ admin/announcement/management.php [L,QSA]
RewriteRule ^admin/announcement/add/?$ admin/announcement/add.php [L,QSA]
RewriteRule ^admin/announcement/view/([0-9]+)/?$ admin/announcement/view.php?announcement_id=$1 [L,QSA]
RewriteRule ^admin/announcement/edit/([0-9]+)/?$ admin/announcement/edit.php?id=$1 [L,QSA]
RewriteRule ^admin/announcement/delete/([0-9]+)/?$ admin/announcement/delete.php?announcement_id=$1 [L,QSA]

RewriteRule ^admin/event/management/?$ admin/event/management.php [L,QSA]
RewriteRule ^admin/event/add/?$ admin/event/add.php [L,QSA]
RewriteRule ^admin/event/view/([0-9]+)/?$ admin/event/view.php?event_id=$1 [L,QSA]
RewriteRule ^admin/event/edit/([0-9]+)/?$ admin/event/edit.php?id=$1 [L,QSA]
RewriteRule ^admin/event/delete/([0-9]+)/?$ admin/event/delete.php?event_id=$1 [L,QSA]

RewriteRule ^admin/class-section/management/?$ admin/class-section/management.php [L,QSA]
