RewriteRule ^admin/class-section/view/([0-9]+)/?$ admin/class-section/view.php?class_section_id=$1 [L,QSA]
RewriteRule ^admin/class-section/edit/([0-9]+)/?$ admin/class-section/edit.php?id=$1 [L,QSA]
RewriteRule ^admin/class-section/delete/([0-9]+)/?$ admin/class-section/delete.php?class_section_id=$1 [L,QSA]

RewriteRule ^admin/user/management/?$ admin/user/management.php [L,QSA]
RewriteRule ^admin/user/add/?$ admin/user/add.php [L,QSA]
RewriteRule ^admin/user/view/([0-9]+)/?$ admin/user/view.php?id=$1 [L,QSA]
